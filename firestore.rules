
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Allow users to read their own transactions
    match /transactions/{transactionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /transfer/{transferId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    
      allow get: if request.auth.uid == resource.data.senderId
                  || request.auth.uid == resource.data.recipientId;

      allow list: if request.query.filters['senderId'] == request.auth.uid;

      allow list: if request.query.filters['recipientId'] == request.auth.uid;

      allow write: if false; 
      
      
    }

    match /topup/{topupId} {

      allow get: if request.auth.uid == resource.data.userId;
      

      allow list: if request.query.filters['userId'] == request.auth.uid;
      

      allow write: if false; 
    }
  }
}
